rules_version = '2';

// COMO USAR: Console do Firebase > Firestore Database > Regras > cole
// isso substituindo o que já estiver lá > Publicar.
//
// Estrutura de dados esperada:
//
// operators/{uid}
//   community: string   (nome de exibição da comunidade)
//   role:      "admin" | "community"
//   active:    boolean  (o admin controla isso pelo painel de admin
//                         dentro do próprio app — tecla A na tela de
//                         login/depois de logar como admin)
//
// rifao_live/{uid}   (uid = mesmo uid da comunidade logada)
//   prizeNumber, currentNumber, updatedAt, history[]
//   -> é o documento que a página da plateia (index.html) lê ao vivo.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/operators/$(request.auth.uid)).data.role == 'admin';
    }

    // Cadastro de quem pode publicar. Cada comunidade só lê o PRÓPRIO
    // documento (pra checar se está ativa). O admin (você) pode ler e
    // escrever qualquer documento — é assim que o painel de admin dentro
    // do app consegue criar/bloquear/liberar comunidades.
    match /operators/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Estado do sorteio de cada comunidade.
    // Leitura: pública (a plateia não precisa de login).
    // Escrita: só a própria comunidade logada, e só se estiver "active".
    match /rifao_live/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.uid == uid
                    && get(/databases/$(database)/documents/operators/$(request.auth.uid)).data.active == true;
    }
  }
}
